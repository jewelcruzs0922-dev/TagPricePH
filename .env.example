# TagPricePH backend configuration — documentational only, no real secrets.
# Copy to .env.local for local work; set the real values in the deployment
# environment (vercel env pull / dashboard). Server-only values below must
# never be prefixed NEXT_PUBLIC_ or referenced from client code.

# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection for the app (lib/db/index.ts reads POSTGRES_URL, then
# DATABASE_URL). Neon: use the -pooler (pooled) endpoint here.
POSTGRES_URL=
# Direct/unpooled endpoint for migrations and verification scripts
# (scripts/migrate.mjs prefers DATABASE_URL_UNPOOLED, then
# POSTGRES_URL_NON_POOLING, then falls back to the pooled URLs).
DATABASE_URL_UNPOOLED=

# ── Data mode ────────────────────────────────────────────────────────────────
# "false" switches reads to the provider registry. Anything else runs the
# demo catalog. The UI banners read each offer's stored source, never this
# flag, so the flag cannot dress demo data up as live pricing.
NEXT_PUBLIC_DEMO_MODE=true
# Which provider serves reads when demo mode is off: demo | db | shopee |
# lazada | tiktok-shop. While demo mode is off, leaving this unset — or
# setting it to "demo" — makes the app fail closed with an error instead of
# silently serving sample data (lib/api/active-provider.ts).
DATA_PROVIDER=demo

# ── Secrets (each one unset disables its surface — see BACKEND_STATUS.md) ────
# Admin session gate. Unset → /admin and its API answer like disabled (503).
ADMIN_TOKEN=
# Ingest lock. Unset → /api/ingest answers 404, as if it did not exist.
INGEST_SECRET=
# Bearer token for POST /api/alerts/check (Vercel cron sends it). Unset →
# the endpoint answers 503 in every environment, including local dev.
CRON_SECRET=

# ── Test-only (never read by the app at runtime) ─────────────────────────────
# CHROME_PATH=  # override for mobile-verify's Chrome discovery
