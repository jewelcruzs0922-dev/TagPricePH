{
  "name": "tagpriceph",
  "version": "1.0.0",
  "description": "Filipino e-commerce price comparison and tracking",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run trust:verify && npm run db:verify && npm run match:verify && npm run obs:verify && npm run ingest:verify",
    "verify:full": "npm run verify && npm run recorded:verify",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:verify": "node scripts/db-verify.mjs",
    "match:verify": "node scripts/match-verify.mjs",
    "trust:verify": "node scripts/trust-verify.mjs",
    "obs:verify": "node scripts/observations-verify.mjs",
    "ingest:verify": "node scripts/ingest-verify.mjs",
    "recorded:verify": "node scripts/recorded-history-verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
